# Pasta do produto (/pack-profissional-da-beleza/). Regras de domínio (https, www, raiz) ficam no .htaccess da raiz, não aqui.
Options -Indexes
ErrorDocument 404 /pack-profissional-da-beleza/404.html
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/plain .txt
AddCharset utf-8 .html .txt
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain image/svg+xml
</IfModule>
<IfModule mod_headers.c>
# imagens e fonte têm hash no nome (arquivo novo = nome novo): cache de 1 ano é seguro
<FilesMatch "\.(avif|webp|jpg|png|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
